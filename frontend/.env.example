# Frontend environment variables (Vite)
# Local development: point at the backend on the host.
VITE_API_URL=http://localhost:8000/api/v1
# NOTE: in docker-compose and on the VM the browser calls `/api/v1/...` on the
# same origin and nginx forwards `/api/` to the backend service, so no
# VITE_API_URL is needed there — a production build uses same-origin calls.
