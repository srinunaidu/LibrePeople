# ---------------------------------------------------------------------------
# LibrePeople backend environment
# ---------------------------------------------------------------------------

# Option A — Oracle Autonomous Database with a wallet (recommended for ADB)
ORACLE_DSN=librepeopleadb_high
ORACLE_USER=admin
ORACLE_PASSWORD=change-me
ORACLE_WALLET_DIR=./wallet
# Only if the wallet was downloaded with a password (encrypted ewallet.pem)
ORACLE_WALLET_PASSWORD=

# Option B — plain SQLAlchemy URL (local SQLite, or Oracle without a wallet)
# DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=oracle+oracledb://user:password@host:1522/service_name

# Option C — PostgreSQL (LibrePeople new installs, local docker-compose db)
# The compose `db` service reads POSTGRES_* below; point DATABASE_URL at it.
# Values here are placeholders, not credentials.
POSTGRES_USER=librepeople
POSTGRES_PASSWORD=change-me
POSTGRES_DB=librepeople
# DATABASE_URL=postgresql://librepeople:change-me@localhost:5432/librepeople
# In compose the host is `db`:
# DATABASE_URL=postgresql://librepeople:change-me@db:5432/librepeople

# Security - SECRET_KEY must be at least 32 characters in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Field encryption (PII at rest). REQUIRED in production: the backend refuses
# to start without both values, and there is no fallback to SECRET_KEY.
# FIELD_ENCRYPTION_KEYS is a comma-separated list of `key_id:secret` pairs;
# FIELD_ENCRYPTION_ACTIVE_KEY_ID selects the key used for new writes.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FIELD_ENCRYPTION_KEYS=key1:CHANGE-ME-to-a-long-random-secret
FIELD_ENCRYPTION_ACTIVE_KEY_ID=key1

# Bootstrap administrator — no values are stored here.
#
# The application ships with zero users (fail-closed). Supply the first
# SuperAdmin's password only through the environment of the machine that
# creates it; it is never committed, printed, or reused. It must pass the
# password policy (12+ chars, 3 of 4 character classes, not derived from
# the username/email). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# See backend/scripts/seed_admin.py (operator path: creates the account in
# a must_change_password state) and the startup seed in backend/app/main.py
# (same variables, same policy, idempotent).
#ADMIN_INITIAL_USERNAME=admin
#ADMIN_INITIAL_EMAIL=admin@example.com
#ADMIN_INITIAL_PASSWORD=
# Synthetic development seed data (seed/dev/). Off by default; never enable
# in production.
#ALLOW_DEV_SEED=false

# CORS — comma-separated origins, or * for all. Empty (default) is
# same-origin only, which is the safe default for a token API.
BACKEND_CORS_ORIGINS=*

# Reverse proxies whose X-Forwarded-* headers are believed (comma-separated
# CIDRs). Empty means none are trusted. Set this to the deployment's own
# proxy subnet when running behind one.
#TRUSTED_PROXY_CIDRS=

# Environment
ENVIRONMENT=development

# Alembic at startup. Safe for the single-instance deployment; for
# multi-instance, set false and run `python -m scripts.migrate upgrade`
# as a separate release step.
#MIGRATE_ON_STARTUP=true

# Log verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
#LOG_LEVEL=INFO

# Storage: "local" (ephemeral) or "oci" (Oracle Object Storage)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/tmp/librepeople-storage
OCI_NAMESPACE=
OCI_BUCKET_NAME=
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# Email delivery (LP-NOT-002) — "log" (default) or "smtp". Values here are
# placeholders, not credentials. SMTP sends through any relay with the
# stdlib only; no vendor SDK is used.
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=no-reply@example.com
